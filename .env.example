# ==============================================================================
# MTS Cloud AIOps Copilot — Конфигурация API ключей нейросетей
# ==============================================================================
# Скопируйте этот файл в .env (cp .env.example .env) и укажите ваши параметры.
# Если ключ не указан, система АВТОМАТИЧЕСКИ переключается в автономный режим
# SRE Replay Engine (детерминированная работа без интернета и без ошибок 401).

# ------------------------------------------------------------------------------
# 1. OpenAI / ChatGPT (Стандартный провайдер)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AIOPS_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. DeepSeek (Очень доступно и высокое качество SRE кода)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-your-deepseek-api-key
# OPENAI_BASE_URL=https://api.deepseek.com
# AIOPS_MODEL=deepseek-chat

# ------------------------------------------------------------------------------
# 3. OpenRouter (Универсальный шлюз: Claude 3.5, Llama 3, Gemini, Mistral)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-or-v1-your-openrouter-key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# AIOPS_MODEL=anthropic/claude-3.5-sonnet

# ------------------------------------------------------------------------------
# 4. YandexGPT (Российский корпоративный контур через OpenAI-совместимый шлюз)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=AQVN...your-yandex-api-key
# OPENAI_BASE_URL=https://llm.api.cloud.yandex.net/foundationModels/v1
# AIOPS_MODEL=yandexgpt/latest
